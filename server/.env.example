# WHY IT Services Environment Variables Template
PORT=4000
NODE_ENV=development

# Neon PostgreSQL Database Connection URL
DATABASE_URL=

# Cryptographic JWT Auth Key & Expiration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Resend Transactional Email API Key & Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_RECEIVER_EMAIL=

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=

# Allowed CORS Client Origins (Frontend Vercel / Localhost)
CLIENT_URL=http://localhost:3000

# Initial Super Admin User Credentials
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
